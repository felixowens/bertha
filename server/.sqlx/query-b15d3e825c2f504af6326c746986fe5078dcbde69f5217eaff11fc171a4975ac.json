  "query": "SELECT id, short_id, type, message, level, status, snooze_remaining, snooze_until, resolved_at,\n                resolved_in_release, resolved_from\n         FROM issues\n         WHERE project_id = ?1 AND (fingerprint = ?2\n               OR id = (SELECT issue_id FROM issue_aliases WHERE project_id = ?1 AND fingerprint = ?2))\n         ORDER BY fingerprint = ?2 DESC LIMIT 1",

# /etc/bertha/env: bertha's settings. install.sh creates it from this file the first
# time; edit it, then `systemctl restart bertha`. bertha refuses to start with a
# message that names the problem if something here is wrong.

# The address people and SDKs use. Links in emails point here.
BERTHA_URL=https://bertha.example.com

# Where bertha listens. Keep it on localhost: Caddy is the public side.
BERTHA_BIND=127.0.0.1:3000

# Proxies whose X-Forwarded-For bertha believes, besides localhost: addresses or
# ranges, comma-separated. Only needed when the proxy isn't on the same host, e.g.
# Traefik in Docker (172.16.0.0/12). Used when an SDK asks for the visitor's address.
# BERTHA_TRUSTED_PROXIES=

# Mail, for sign-in links, invitations and email alerts. Without SMTP_HOST, emails
# are written to the log instead (journalctl -u bertha), which is fine to start with.
SMTP_HOST=smtp.example.com
# tls (usually port 465), starttls (587, the default) or none (local relays only).
SMTP_SECURITY=starttls
SMTP_PORT=587
SMTP_USERNAME=bertha@example.com
SMTP_PASSWORD=
SMTP_FROM="bertha <bertha@example.com>"

# A GitHub token, so bertha can follow a fixed triage's PR until a production release
# contains it, then resolve the issue. Make a fine-grained token with read-only
# Contents and Pull requests on the repos your projects use. Without it, fixes wait
# until someone marks them shipped.
# BERTHA_GITHUB_TOKEN=

# A project for bertha's own errors, by its key, id or name: the server's errors and
# log lines, and the app's errors in the browser. Off when unset.
# BERTHA_REPORT_TO=BRTA

# Events, checks and source maps older than this are deleted. Issues and their
# hourly counts stay. 1 to 3650.
BERTHA_RETENTION_DAYS=90

# The region name shown on uptime checks.
BERTHA_REGION=bertha

# Log detail: info is right for most days; debug when looking into something.
RUST_LOG=info,tower_http=warn,sqlx=warn

# Caddy in front of bertha: TLS, compression and HTTP/2. Replace the address with
# yours (the same as BERTHA_URL) and append this to /etc/caddy/Caddyfile.
#
# bertha answers CORS for /ingest itself, so browsers on your apps' domains can send
# errors straight here. Nothing else is needed for that.

bertha.example.com {
	encode zstd gzip

	reverse_proxy 127.0.0.1:3000 {
		# Live updates are a long-lived event stream: pass each event on at once.
		flush_interval -1
	}

	log {
		output file /var/log/caddy/bertha.log
		format json
	}
}

# bertha's settings for compose.yaml. Copy to .env (mode 0600: it holds the SMTP
# password), fill it in, then `docker compose up -d --build`. Every bertha setting in
# ../env.example works here too.

# The release to build. Upgrading is changing this and running up -d --build again.
BERTHA_VERSION=v0.1.3

# The address people and SDKs use, and the same host for Traefik.
BERTHA_URL=https://bertha.example.com
BERTHA_HOST=bertha.example.com

# Traefik: its Docker network, HTTPS entrypoint and certificate resolver.
TRAEFIK_NETWORK=traefik_web
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# Traefik reaches bertha from the Docker network, so believe its X-Forwarded-For there.
# Docker's default address pools are all inside this range.
BERTHA_TRUSTED_PROXIES=172.16.0.0/12

# Mail, for sign-in links, invitations and email alerts. Without SMTP_HOST, emails are
# written to the log instead (docker compose logs bertha).
SMTP_HOST=
SMTP_SECURITY=starttls
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="bertha <bertha@example.com>"

BERTHA_RETENTION_DAYS=90
BERTHA_REGION=bertha
RUST_LOG=info,tower_http=warn,sqlx=warn

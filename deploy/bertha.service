# bertha as a systemd service. install.sh puts this in /etc/systemd/system/.
#
#   systemctl status bertha
#   journalctl -u bertha -f

[Unit]
Description=bertha error tracking and uptime
Documentation=https://github.com/felixowens/bertha/blob/main/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=bertha
Group=bertha
EnvironmentFile=/etc/bertha/env
Environment=DATABASE_PATH=/var/lib/bertha/bertha.db
Environment=BERTHA_LOG_FORMAT=json
ExecStart=/usr/local/lib/bertha/bertha serve
Restart=on-failure
RestartSec=2s
# bertha finishes the ingest queue and the pass each worker is in, then exits.
TimeoutStopSec=30s

# /var/lib/bertha, owned by the bertha user and kept across restarts and upgrades.
StateDirectory=bertha
StateDirectoryMode=0750
WorkingDirectory=/var/lib/bertha

# It needs the network and its own directory, nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027

# A ceiling, well above the ~30 MB it uses idle.
MemoryMax=256M
TasksMax=256

[Install]
WantedBy=multi-user.target

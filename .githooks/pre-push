#!/usr/bin/env bash
# Runs scripts/release-gate.sh for every release tag being pushed, however it was made,
# and, for the commits going to main (where CI doesn't run): the contract and migration
# guards, the app's type check (which holds the server to the contract), the design lint
# and the changelog's shape. A few seconds; the Rust checks stay with you and the release.
# Turned on by `npm install` (core.hooksPath). Skip once with `git push --no-verify`.
set -euo pipefail
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha _remote_ref remote_sha; do
  if [[ "$local_ref" == refs/heads/main && "$local_sha" != "$zero" && "$remote_sha" != "$zero" ]]; then
    node scripts/contract-guard.ts "$remote_sha..$local_sha"
    node scripts/migrations-guard.ts "$remote_sha..$local_sha"
    if [[ ! -x node_modules/.bin/tsc ]]; then
      echo "pre-push: node_modules is missing, so the app can't be type-checked. Run npm install." >&2
      exit 1
    fi
    node_modules/.bin/tsc --noEmit -p tsconfig.app.json
    node .prototype/design-lint.ts
    node scripts/changelog.ts check
  fi
  [[ "$local_ref" == refs/tags/v* && "$local_sha" != "$zero" ]] || continue
  scripts/release-gate.sh "${local_ref#refs/tags/}" "$local_sha"
done
